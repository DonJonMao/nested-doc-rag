FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /bin/gongkan-api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /bin/gongkan-api /app/gongkan-api
COPY configs /app/configs
COPY migrations /app/migrations
EXPOSE 8080
ENTRYPOINT ["/app/gongkan-api"]
