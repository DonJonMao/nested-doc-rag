GONGKAN_DATABASE_DSN=postgres://gongkan:gongkan@postgres:5432/gongkan?sslmode=disable
GONGKAN_REDIS_ADDR=redis:6379
GONGKAN_MINIO_ENDPOINT=minio:9000
GONGKAN_MINIO_ACCESS_KEY=minioadmin
GONGKAN_MINIO_SECRET_KEY=replace-with-minio-secret
GONGKAN_JWT_SECRET=replace-with-long-random-secret
GONGKAN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
GONGKAN_BOOTSTRAP_ADMIN_PASSWORD_ENV=GONGKAN_BOOTSTRAP_ADMIN_PASSWORD
GONGKAN_PYTHON_EXECUTABLE=python
GONGKAN_PYTHON_PROJECT_DIR=/app/python-core
DEEPSEEK_API_KEY=replace-with-provider-key
