FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /bin/gongkan-worker ./cmd/worker

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /bin/gongkan-worker /app/gongkan-worker
COPY configs /app/configs
COPY migrations /app/migrations
ENTRYPOINT ["/app/gongkan-worker"]
