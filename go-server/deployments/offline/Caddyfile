{$DOMAIN::80} {
	encode gzip
	root * /srv/web
	request_body {
		max_size 2048MB
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer-when-downgrade
	}
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	@api_health path /healthz /readyz
	handle @api_health {
		reverse_proxy api:8080
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
